{
  "name": "@sigsig/keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": { "keeper": "src/cli.ts" },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "keeper": "tsx src/cli.ts",
    "start": "tsx src/cli.ts run",
    "once": "tsx src/cli.ts once",
    "dry": "tsx src/cli.ts once --dry-run",
    "status": "tsx src/cli.ts status"
  },
  "dependencies": {
    "cashscript": "^0.13.0",
    "@bitauth/libauth": "^3.0.0",
    "@sigsig/core": "workspace:*"
  },
  "devDependencies": { "cashc": "0.13.3" }
}
